# ORBIT — contoh konfigurasi lokal. Salin ke .env dan isi bila perlu.
# Tanpa .env sama sekali, server tetap jalan dengan AI lokal deterministik.

# Provider AI utama (opsional): gateway/kunci asli → otomatis dipakai rantai.
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_UA=ZCode/2.1.0
# GEMINI_API_KEY=
# AI_PROVIDER=openai-responses|gemini|local   (default: otomatis sesuai kunci)
# AI_COOLDOWN_MS=60000

# Gateway pembayaran (opsional): tanpa kunci → mode mock (simulasi lokal).
# MIDTRANS_SERVER_KEY=
# MIDTRANS_ENV=sandbox

# CORS origin untuk preview mobile/web eksternal (default *)
# CORS_ORIGIN=http://localhost:8090

# Error tracking Sentry (opsional — tanpa DSN: no-op). Format DSN lengkap dari dashboard Sentry.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENV=development
